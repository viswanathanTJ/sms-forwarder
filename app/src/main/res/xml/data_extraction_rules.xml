<?xml version="1.0" encoding="utf-8"?>
<!--
   Android 12+ backup / device-to-device transfer rules. allowBackup=false stops cloud backup but NOT
   device-to-device transfer, so the SMS log, the encrypted bot token (DataStore) and preferences are
   excluded explicitly. (The Keystore key never transfers, so a copied token could not be decrypted anyway.)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="forwarder.db" />
        <exclude domain="database" path="forwarder.db-wal" />
        <exclude domain="database" path="forwarder.db-shm" />
        <exclude domain="database" path="forwarder.db-journal" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="forwarder.db" />
        <exclude domain="database" path="forwarder.db-wal" />
        <exclude domain="database" path="forwarder.db-shm" />
        <exclude domain="database" path="forwarder.db-journal" />
        <exclude domain="file" path="datastore/" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
